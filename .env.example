# Copy to .env and fill in. Never commit .env. Keys stay on the server.
OPENAI_API_KEY=sk-...
# Optional: any chat model that supports tool calling (default gpt-4o-mini)
# OPENAI_MODEL=gpt-4o

# Only for a host with no persistent disk (e.g. Render free). Leave unset locally: data stays in budget.db.
# TURSO_DATABASE_URL=libsql://your-db-your-org.turso.io
# TURSO_AUTH_TOKEN=...
# Sign-in. The owner logs in with ADMIN_USER + APP_PASSWORD; the owner then creates family accounts at /admin.
# APP_PASSWORD is required on any deployed server.
# ADMIN_USER=yourname
# APP_PASSWORD=a-long-password
# Assistant messages per family member per day (the owner is unlimited):
# CHAT_DAILY_LIMIT=40
